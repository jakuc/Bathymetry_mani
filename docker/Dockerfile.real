# Obraz do pracy z prawdziwym sprzętem (serwo XM540 + echosonda SLD-100, docelowo GPS/IMU).
# Celowo BEZ Isaac Sim (~25GB, 30-90 min budowy w docker/Dockerfile) - nie jest tu potrzebny,
# weryfikacja odbywa się na realnym sprzęcie, nie w symulatorze.
# Ten sam workspace (src/) co obraz symulacyjny - bathset_description i tak referencuje
# xm540_bringup przez xacro:include, więc oba obrazy muszą widzieć to samo drzewo źródeł.
FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Warsaw
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8

# =============================================================================
# Warstwa 1: Zależności systemowe
# =============================================================================
RUN apt-get update && apt-get install -y \
    curl wget git gnupg2 lsb-release \
    software-properties-common \
    python3 python3-pip python3-venv \
    build-essential cmake \
    udev \
    nano \
    && rm -rf /var/lib/apt/lists/*

# =============================================================================
# Warstwa 2: ROS2 Humble (Ubuntu 22.04 Jammy) + ros2_control + xacro
# Ten sam dystrybutor co docker/Dockerfile (kontener symulacyjny) - host używa Jazzy,
# ale to bez znaczenia, build i tak dzieje się tu w środku.
# =============================================================================
RUN curl -sSL https://raw.githubusercontent.com/ros/rosdistro/master/ros.key \
        -o /usr/share/keyrings/ros-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/ros-archive-keyring.gpg] \
        http://packages.ros.org/ros2/ubuntu $(lsb_release -cs) main" \
        > /etc/apt/sources.list.d/ros2.list && \
    apt-get update && apt-get install -y \
    ros-humble-ros-base \
    ros-humble-robot-state-publisher \
    ros-humble-rviz2 \
    ros-humble-tf2-ros \
    ros-humble-tf2-geometry-msgs \
    ros-humble-std-srvs \
    ros-humble-dynamixel-sdk \
    ros-humble-ros2-control \
    ros-humble-ros2-controllers \
    ros-humble-xacro \
    python3-colcon-common-extensions \
    python3-rosdep \
    python3-argcomplete \
    && rm -rf /var/lib/apt/lists/*

# =============================================================================
# Warstwa 3: udev rules (referencyjnie w obrazie; realne symlinki tworzy host)
# =============================================================================
COPY udev/99-dynamixel.rules /opt/udev/99-dynamixel.rules
COPY udev/99-echosounder.rules /opt/udev/99-echosounder.rules
COPY udev/99-gnss.rules /opt/udev/99-gnss.rules

# =============================================================================
# Entrypoint - ten sam co obraz symulacyjny (sourcing workspace, brak /opt/ros_ws
# prebuild tutaj - kompilacja robiona ręcznie przez użytkownika w /workspace)
# =============================================================================
COPY docker/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

RUN echo "source /opt/ros/humble/setup.bash" >> ~/.bashrc && \
    echo "[ -f /workspace/install/setup.bash ] && source /workspace/install/setup.bash" >> ~/.bashrc && \
    echo "cb() { colcon build \"\$@\" && source /workspace/install/setup.bash; }" >> ~/.bashrc

WORKDIR /workspace

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
