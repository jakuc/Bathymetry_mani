<?xml version="1.0"?>
<robot name="xm540_manipulator">

  <!-- Punkt zaczepu w świecie – fix_base=True w Isaac Sim fiksuje ten link -->
  <link name="world">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <!-- Translacja X łódki -->
  <link name="boat_x_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <joint name="joint_boat_x" type="prismatic">
    <parent link="world"/>
    <child link="boat_x_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-2000" upper="2000" effort="100000" velocity="100"/>
  </joint>

  <!-- Translacja Y łódki -->
  <link name="boat_y_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <joint name="joint_boat_y" type="prismatic">
    <parent link="boat_x_link"/>
    <child link="boat_y_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2000" upper="2000" effort="100000" velocity="100"/>
  </joint>

  <!-- Baza manipulatora – obrócona π wokół X, by sonar patrzył w dół -->
  <link name="base_link">
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <joint name="boat_to_base" type="fixed">
    <parent link="boat_y_link"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="3.14159 0 0"/>
  </joint>

  <!-- Człon 0 – baza, nieruchomy -->
  <link name="link_0">
    <visual>
      <origin xyz="0 0 0" rpy="3.14159 0 0"/>
      <geometry>
        <mesh filename="package://xm540_bringup/meshes/link_0.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="robot_grey">
        <color rgba="0.6 0.6 0.65 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="3.14159 0 0"/>
      <geometry>
        <mesh filename="package://xm540_bringup/meshes/link_0.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.3"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0003"/>
    </inertial>
  </link>

  <joint name="base_to_link0" type="fixed">
    <parent link="base_link"/>
    <child link="link_0"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Człon 1 -->
  <link name="link_1">
    <visual>
      <geometry>
        <mesh filename="package://xm540_bringup/meshes/link_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="robot_grey">
        <color rgba="0.6 0.6 0.65 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://xm540_bringup/meshes/link_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <joint name="xm540_joint_z" type="revolute">
    <parent link="link_0"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.1255" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.5708" upper="1.5708" effort="10.6" velocity="2.69"/>
  </joint>

  <!-- Człon 2 -->
  <link name="link_2">
    <visual>
      <geometry>
        <mesh filename="package://xm540_bringup/meshes/link_2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="robot_grey">
        <color rgba="0.6 0.6 0.65 1.0"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <mesh filename="package://xm540_bringup/meshes/link_2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <joint name="xm540_joint" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0.0635 0.062" rpy="0 1.5708 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.5708" upper="1.5708" effort="10.6" velocity="2.69"/>
  </joint>

  <!-- Sonar – zafixowany do link_2, wiązka wzdłuż +X sonar_link -->
  <link name="sonar_link">
    <visual>
      <origin rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.05" length="0.10"/>
      </geometry>
      <material name="sonar_yellow">
        <color rgba="1.0 0.8 0.0 1.0"/>
      </material>
    </visual>
    <inertial>
      <mass value="0.001"/>
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001"/>
    </inertial>
  </link>

  <joint name="sonar_joint" type="fixed">
    <parent link="link_2"/>
    <child link="sonar_link"/>
    <origin xyz="-0.137 -0.0555 0" rpy="0 3.14159 0"/>
  </joint>

</robot>
