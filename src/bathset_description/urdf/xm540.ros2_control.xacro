<?xml version="1.0"?>
<!--
  Blok <ros2_control> dla realnego sprzętu, osobno od opisu kinematyki.
  Includowany przez bathset.urdf.xacro razem z nietkniętym
  urdf/xm540_manipulator.urdf z paczki xm540_bringup — dzięki temu zmiana
  backendu sprzętowego (np. na mock_components do testów bez sprzętu) to
  tylko podmiana tego jednego pliku, bez ruszania opisu robota.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!--
    use_servo / use_echosounder: sterują tym, czy dany blok w ogóle trafia do
    URDF. controller_manager (ta wersja ros2_control) twardo pada (abort całego
    procesu), jeśli zadeklarowany komponent sprzętowy nie osiągnie stanu
    "active" przy starcie - a to się dzieje zawsze, gdy dane urządzenie akurat
    nie jest fizycznie podpięte. Zamiast łapać ten wyjątek, po prostu nie
    deklarujemy komponentu, którego nie ma - nie ma czego aktywować, nie ma
    czego crashować.
  -->
  <xacro:arg name="use_servo" default="true"/>
  <xacro:arg name="use_echosounder" default="true"/>
  <xacro:arg name="use_gnss" default="true"/>
  <xacro:arg name="use_imu" default="true"/>

  <!--
    servo_id: adres serwa na magistrali Dynamixel. Adres siedzi w EEPROM serwa,
    więc wymiana egzemplarza zmienia go bez żadnego śladu w repo - stąd argument
    zamiast literału, żeby dopasować się z linii poleceń bez edycji URDF-a.

    Stan sprzętu (2026-08-07): na magistrali są DWA serwa XM540-W270, oba @1 Mbps:
      ID 1 - człon 2 (głowica), firmware 50
      ID 2 - człon 1,           firmware 48
    Ten blok deklaruje na razie tylko jedno z nich (jeden joint), więc servo_id
    wybiera, które. Adresy sprawdzisz skanem magistrali, nie zgadywaniem.
  -->
  <xacro:arg name="servo_id" default="1"/>

  <!--
    Profil ruchu serwa. Zero znaczy u Dynamixela "bez profilu", czyli dojazd do
    zadanej pozycji z maksymalną prędkością - na samym manipulatorze przechodziło
    bez echa, ale z zamontowaną głowicą każdy skok komendy szarpie całą
    konstrukcją. Stąd niezerowe wartości domyślne na realnym sprzęcie.
    Jednostki wg dokumentacji XM540: prędkość 0,229 obr/min na jednostkę
    (30 = 6,9 obr/min), przyspieszenie 214,577 obr/min^2 (10 -> rozpęd ~0,2 s).
  -->
  <xacro:arg name="profile_velocity" default="30"/>
  <xacro:arg name="profile_acceleration" default="10"/>

  <!--
    Zero mechaniczne każdej osi wyrażone w surowej pozycji serwa (0..4095).
    Po zmontowaniu głowicy zero konstrukcji nie wypada w środku zakresu enkodera
    (2048), więc bez tego jointy w URDF-ie kłamałyby o rzeczywistym położeniu.
    Wartości zmierzone 2026-08-07 przy głowicy ustawionej w pozycji zerowej;
    po każdym rozkręceniu i złożeniu trzeba je odczytać na nowo (skan magistrali
    pokazuje present_position).
  -->
  <xacro:arg name="center_raw" default="2670"/>      <!-- ID 1, człon 2 (głowica) -->
  <xacro:arg name="center_raw_z" default="3353"/>    <!-- ID 2, człon 1 -->

  <!--
    Czy druga oś (xm540_joint_z, ID 2) ma być w ogóle deklarowana.
    Domyślnie FALSE, mimo że serwo fizycznie jest: przy dwóch jointach
    forward_position_controller oczekuje komendy dwuelementowej, a
    goal_position_bridge (i stojący za nim manual_node z xm540_bringup)
    publikuje jednoelementową - kontroler odrzuciłby ją jako niezgodną
    rozmiarem. Włączenie drugiej osi wymaga więc sterowania, które podaje
    obie wartości naraz. Patrz launch: przy use_servo_z:=true most i
    manual_node nie są uruchamiane.
  -->
  <xacro:arg name="use_servo_z" default="false"/>
  <xacro:arg name="servo_id_z" default="2"/>

  <xacro:if value="$(arg use_servo)">
    <ros2_control name="xm540_servo" type="system">
      <hardware>
        <plugin>hardware_controller/DynamixelSystem</plugin>
        <param name="device_port">/dev/u2d2</param>
        <param name="baud_rate">1000000</param>
        <param name="profile_velocity">$(arg profile_velocity)</param>
        <param name="profile_acceleration">$(arg profile_acceleration)</param>
      </hardware>
      <joint name="xm540_joint">
        <param name="servo_id">$(arg servo_id)</param>
        <param name="center_raw">$(arg center_raw)</param>
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
        <state_interface name="temperature"/>
      </joint>
      <xacro:if value="$(arg use_servo_z)">
        <joint name="xm540_joint_z">
          <param name="servo_id">$(arg servo_id_z)</param>
          <param name="center_raw">$(arg center_raw_z)</param>
          <command_interface name="position"/>
          <state_interface name="position"/>
          <state_interface name="velocity"/>
          <state_interface name="effort"/>
          <state_interface name="temperature"/>
        </joint>
      </xacro:if>
    </ros2_control>
  </xacro:if>

  <xacro:if value="$(arg use_echosounder)">
    <ros2_control name="echosounder" type="sensor">
      <hardware>
        <plugin>hardware_controller/EchosounderSensor</plugin>
        <param name="device_port">/dev/echosounder</param>
        <param name="baud_rate">4800</param>
      </hardware>
      <sensor name="echosounder">
        <state_interface name="range"/>
        <state_interface name="water_temperature"/>
      </sensor>
    </ros2_control>
  </xacro:if>

  <!--
    Septentrio mosaic-H (dwuantenowy GNSS: pozycja + heading) po USB CDC-ACM.
    /dev/gnss = pierwszy port CDC odbiornika (USB1) - patrz udev/99-gnss.rules.
    Wtyczka sama włącza strumień NMEA GGA+GST+HDT na wskazanym porcie
    odbiornika (receiver_port/nmea_stream/nmea_rate to parametry komendy
    setNMEAOutput), więc odbiornik nie wymaga wcześniejszej konfiguracji.
  -->
  <xacro:if value="$(arg use_gnss)">
    <ros2_control name="gnss" type="sensor">
      <hardware>
        <plugin>hardware_controller/GnssSensor</plugin>
        <param name="device_port">/dev/gnss</param>
        <param name="baud_rate">115200</param>
        <param name="receiver_port">USB1</param>
        <param name="nmea_stream">1</param>
        <param name="nmea_rate">msec100</param>
        <!--
          RTK: samo połączenie z casterem NTRIP jest skonfigurowane na stałe w
          pamięci odbiornika (scripts/gnss_rtk.py configure) - tutaj tylko
          włączamy podgląd jego stanu, żeby login i hasło do serwisu RTK nie
          trafiły do repozytorium. status_stream=0 wyłącza podgląd.
        -->
        <param name="status_stream">2</param>
        <param name="status_rate">sec1</param>
        <param name="ntrip_connection">1</param>
      </hardware>
      <sensor name="gnss">
        <state_interface name="latitude"/>
        <state_interface name="longitude"/>
        <state_interface name="altitude"/>
        <state_interface name="fix_quality"/>
        <state_interface name="num_satellites"/>
        <state_interface name="lat_std"/>
        <state_interface name="lon_std"/>
        <state_interface name="alt_std"/>
        <state_interface name="heading"/>
        <state_interface name="diff_age"/>
        <state_interface name="station_id"/>
        <state_interface name="ntrip_status"/>
        <state_interface name="ntrip_error"/>
        <state_interface name="data_count"/>
      </sensor>
    </ros2_control>
  </xacro:if>

  <!--
    IMU GY-955 (BNO055 z własnym MCU) po UART. Na Pi to /dev/serial0 (ttyS0),
    czyli wbudowany port na pinach 8/10 - NIE jest to USB, więc nie ma tu reguły
    udev: ścieżka jest stała.

    UWAGA na dwie rzeczy przy pierwszym uruchomieniu na świeżej płytce:
      - `serial-getty@ttyS0` musi być wyłączony, bo inaczej agetty trzyma port
        (i trzyma go w grupie `tty` zamiast `dialout`);
      - z /boot/firmware/cmdline.txt trzeba usunąć `console=serial0,115200`.
    Obie rzeczy robi deploy/rpi/install.sh.

    module_cmd 0xB5 = AUTO + 50 Hz + kwaternion + żyroskop + akcelerometr, czyli
    dokładnie komplet dla sensor_msgs/Imu. Kwaternion, a nie Euler, bo kanały
    Eulera tego modułu nazywają się odwrotnie niż w REP-103.
  -->
  <xacro:if value="$(arg use_imu)">
    <ros2_control name="imu" type="sensor">
      <hardware>
        <plugin>hardware_controller/ImuSensor</plugin>
        <param name="device_port">/dev/serial0</param>
        <param name="baud_rate">9600</param>
        <param name="module_cmd">0xB5</param>
        <param name="configure_module">true</param>
        <!-- Kolejność składowych kwaternionu w ramce; "xyzw", jeśli orientacja
             wyjdzie przekręcona (instrukcja modułu tego nie precyzuje). -->
        <param name="quaternion_order">wxyz</param>
      </hardware>
      <sensor name="imu">
        <state_interface name="orientation.x"/>
        <state_interface name="orientation.y"/>
        <state_interface name="orientation.z"/>
        <state_interface name="orientation.w"/>
        <state_interface name="angular_velocity.x"/>
        <state_interface name="angular_velocity.y"/>
        <state_interface name="angular_velocity.z"/>
        <state_interface name="linear_acceleration.x"/>
        <state_interface name="linear_acceleration.y"/>
        <state_interface name="linear_acceleration.z"/>
        <state_interface name="calib_sys"/>
        <state_interface name="calib_gyr"/>
        <state_interface name="calib_acc"/>
        <state_interface name="calib_mag"/>
      </sensor>
    </ros2_control>
  </xacro:if>

</robot>
